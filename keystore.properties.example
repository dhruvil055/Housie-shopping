# Housie Shopping Release Signing Configuration Example
# Copy this file to 'keystore.properties' and fill in your actual credentials.
# NEVER commit 'keystore.properties' or any '.keystore'/'.jks' file to source control!

storeFile=../housie-release.keystore
storePassword=your_keystore_password_here
keyAlias=housieshopping
keyPassword=your_key_password_here
