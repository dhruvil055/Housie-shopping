# Housie Shopping Backend Environment Configuration

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Database
MONGODB_URI=mongodb://localhost:27017/housie_shopping

# Security & JWT Tokens
JWT_SECRET=housie_jwt_secret_change_in_production_super_secure_key_12345
JWT_REFRESH_SECRET=housie_jwt_refresh_secret_change_in_production_key_67890
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100